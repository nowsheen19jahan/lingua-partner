# Copy this file to .env and fill in your values.
# The app reads these at startup via pydantic-settings.

# ── Gemini API ────────────────────────────────────────────────────────────────
# Get a free key at: https://aistudio.google.com/app/apikey
# Free tier: 15 requests/min, 1 million tokens/day — plenty for personal use.
GEMINI_API_KEY=your_api_key_here

# Model to use. Options:
#   gemini-2.5-flash   — fast, free tier, recommended
#   gemini-1.5-flash   — slightly older fast model
#   gemini-1.5-pro     — higher quality, lower rate limits on free tier
GEMINI_MODEL=gemini-2.5-flash

# ── App behaviour ─────────────────────────────────────────────────────────────
# Max conversation turns kept in memory per session
MAX_HISTORY_TURNS=20

# Comma-separated list of allowed CORS origins. Use * to allow all.
CORS_ORIGINS=*
